# Database (Neon / Vercel Postgres / any Postgres with SSL)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Session & encryption
# Generate a 32-byte hex key for AES-256-GCM token encryption:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Generate a strong random string for JWT signing:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Shared public key (serverless mode — no per-user DB, no Discord bot).
# Everyone uses this one key, shown on /docs and /keys. Enforced in code
# at 20 requests/min + 500 requests/day per IP (see src/lib/public-access.ts).
PUBLIC_API_KEY=
# Operator key: unlimited, bypasses both gates. Never documented publicly.
ADMIN_API_KEY=

# Public app URL (used in docs page)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Built-in provider gateways (hidden from end users)
# ---------------------------------------------------------------------------
# Each gateway is OpenAI-compatible. Set BASE_URL and API_KEY, then list the
# upstream model IDs to expose. Replace the default model IDs with the actual
# free-tier IDs published by each gateway (usually available at {BASE_URL}/models).

# Aquadevs - free tier models only
AQUADEVS_BASE_URL=
AQUADEVS_API_KEY=
AQUADEVS_MODELS=

# Logfare.ai
LOGFARE_BASE_URL=
LOGFARE_API_KEY=
LOGFARE_MODELS=

# Scriptzz (duckdns)
SCRIPTZZ_BASE_URL=
SCRIPTZZ_API_KEY=
SCRIPTZZ_MODELS=

# Cogito (decart.ai)
COGITO_BASE_URL=
COGITO_API_KEY=
COGITO_MODELS=

# OpenAI (bring-your-own key — slot already wired in src/lib/providers.ts)
# Just set the key; BASE_URL defaults to https://api.openai.com.
# Optional: pin the exposed list (comma-separated) instead of live discovery.
# OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-4o,gpt-4o-mini

# Custom-op: private upstream at <base>/admin/v1/* (inactive until the key is
# set AND the host is publicly reachable — Tailscale-only *.ts.net hostnames
# do NOT resolve from Render). Comma-separated model IDs pin the list when
# the upstream has no /models endpoint.
# CUSTOMOP_BASE_URL=https://serverr.tail2b9fa1.ts.net/admin
CUSTOMOP_API_KEY=
# CUSTOMOP_MODELS=custom-model-id

# Ayechat: private OpenAI-compatible upstream at <base>/admin/v1/* — chat at
# https://rimo-api.mywire.org/admin/v1/chat/completions. Inactive until the
# key is set. Comma-separated model IDs pin the list when the upstream has no
# /models endpoint.
# AYECHAT_BASE_URL=https://rimo-api.mywire.org/admin
AYECHAT_API_KEY=
# AYECHAT_MODELS=model-id-1,model-id-2

# AI Horde (community inference network, accessed through API key)
# Get a key at https://aihorde.net/register
AI_HORDE_API_KEY=
# Comma-separated upstream model IDs to expose from AI Horde, per type.
# Leave empty to use the defaults below.
AI_HORDE_TEXT_MODELS=aphrodite/KoboldAI/LLaMA2-13B-Tiefighter,aphrodite/NeverSleep/Noromaid-13b-v0.1.1
AI_HORDE_IMAGE_MODELS=Deliberate,DreamShaper,Juggernaut XL
