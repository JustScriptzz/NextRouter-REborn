# Database (Neon / Vercel Postgres / any Postgres with SSL)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Session & encryption
# Generate a 32-byte hex key for AES-256-GCM token encryption:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Generate a strong random string for JWT signing:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Public app URL (used in docs page)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Upstream provider gateways (all OpenAI-compatible)
# ---------------------------------------------------------------------------
# Each gateway needs BASE_URL + API_KEY, then the exact upstream model IDs
# to expose (comma-separated). The public catalog is exactly these pin lists.
# Copy a block to add more upstreams.

# Primary upstream
PRIMARY_BASE_URL=
PRIMARY_API_KEY=
PRIMARY_MODELS=

# Secondary upstream (failover / extra models)
SECONDARY_BASE_URL=
SECONDARY_API_KEY=
SECONDARY_MODELS=

# Fallback upstream
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODELS=

# OpenAI (bring-your-own key — slot already wired in src/lib/providers.ts)
# Just set the key; BASE_URL defaults to https://api.openai.com.
# Optional: pin the exposed list (comma-separated) instead of live discovery.
# OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-4o,gpt-4o-mini

# Custom-op: private upstream at <base>/admin/v1/* (inactive until the key is
# set AND the host is publicly reachable — Tailscale-only hostnames
# do NOT resolve from hosted workers). Comma-separated model IDs pin the list when
# the upstream has no /models endpoint.
# CUSTOMOP_BASE_URL=https://YOUR_HOST/admin
CUSTOMOP_API_KEY=
# CUSTOMOP_MODELS=custom-model-id

# AI Horde (community inference network, accessed through API key)
# Get a key at https://aihorde.net/register
AI_HORDE_API_KEY=
# Comma-separated upstream model IDs to expose from AI Horde, per type.
# Leave empty to use the defaults below.
AI_HORDE_TEXT_MODELS=aphrodite/KoboldAI/LLaMA2-13B-Tiefighter,aphrodite/NeverSleep/Noromaid-13b-v0.1.1
AI_HORDE_IMAGE_MODELS=Deliberate,DreamShaper,Juggernaut XL
